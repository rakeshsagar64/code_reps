{
  "id": "module-2",
  "courseId": "regex",
  "order": 2,
  "title": "Quantifiers & Concept Stacking",
  "description": "Control repetition counts (+, *, {n}) combined with M1 character classes.",
  "primer": {
    "syntaxToken": "+, *, {n}, {n,m}",
    "definition": "Quantifiers specify how many times the preceding character or class repeats: + (1 or more), * (0 or more), {n} (exact count), {n,m} (range).",
    "goldenRule": "Quantifiers attach strictly to the single character or character class token immediately preceding them.",
    "mentalModel": "Think of quantifiers as repetition multipliers attached directly to the character class on their left. Lowercase shorthand classes match specific token types, while uppercase shorthand classes invert the match.",
    "points": [
      "+ requires at least 1 match; * allows 0 matches.",
      "{n} sets an exact repetition count, while {n,m} defines an inclusive min and max range.",
      "Capitalization inversion rule: Lowercase shorthands (\\d, \\w, \\s) match digits, word chars, and whitespace, whereas uppercase shorthands (\\D, \\W, \\S) match their exact opposites."
    ],
    "pitfalls": [
      "Confusing + (1+) with * (0+): * matches empty strings/positions.",
      "Assuming word character class matches symbols like ! or @: it only includes letters, digits, and underscores.",
      "Adding spaces inside range quantifiers like {2, 4} will break the regex syntax."
    ],
    "examples": [
      {
        "pattern": "\\d+",
        "match": "123",
        "note": "Matches one or more contiguous digits."
      },
      {
        "pattern": "\\w{3}",
        "match": "cat",
        "note": "Matches exactly three consecutive word characters."
      },
      {
        "pattern": "\\S+",
        "match": "Hello!",
        "note": "Matches one or more non-whitespace characters including punctuation."
      }
    ],
    "testCases": {
      "positive": [
        {
          "target": "9942",
          "expected": "9942",
          "hint": "Use digit matching with quantifier + for 1 or more digits."
        },
        {
          "target": "user_1",
          "expected": "user_1",
          "hint": "Use word character matching with quantifier + for letters, digits, and underscores."
        }
      ],
      "negative": [
        "   ",
        "!@#$"
      ]
    }
  },
  "cards": [

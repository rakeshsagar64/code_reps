      "testCases": [
        { "text": "LOG", "shouldMatch": true },
        { "text": "ERR", "shouldMatch": true },
        { "text": "INFO", "shouldMatch": false },
        { "text": "WARN", "shouldMatch": false }
      ]
    },
    {

      "canonicalSolution": "(\\d{2}){2}",
      "testCases": [
        { "text": "1234", "shouldMatch": true },
        { "text": "12", "shouldMatch": false },
        { "text": "123", "shouldMatch": false },
        { "text": "abcd", "shouldMatch": false }
      ]
    },

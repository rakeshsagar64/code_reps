  "order": 4,
  "title": "Grouping & Concept Stacking",
  "description": "Isolate sub-expressions using (...) and stack with character classes, quantifiers, and anchors.",
  "primer": {
    "syntaxToken": "(...)",
    "definition": "Parentheses group sub-patterns into single units to apply quantifiers, specify alternation, or capture matches.",
    "goldenRule": "Quantifiers placed directly after a closing parenthesis apply to the entire group inside."
  },

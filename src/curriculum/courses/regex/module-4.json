      "type": "compound",
      "scaffold": "blind",
      "prompt": "Match a valid IPv4 address where each octet is constrained to 0-255, rejecting out-of-range values like 999 that the naive grouped pattern from m4_c17 would still accept.",
      "canonicalSolution": "^((25[0-5]|2[0-4]\\d|1\\d{2}|[1-9]?\\d)\\.){3}(25[0-5]|2[0-4]\\d|1\\d{2}|[1-9]?\\d)$",
      "testCases": [
        { "text": "192.168.1.1", "shouldMatch": true, "description": "All four octets are within 0-255." },
        { "text": "255.255.255.255", "shouldMatch": true, "description": "Boundary case: the maximum valid octet value in every position." },
        { "text": "0.0.0.0", "shouldMatch": true, "description": "Boundary case: the minimum valid octet value in every position." },
        { "text": "999.999.999.999", "shouldMatch": false, "description": "Out-of-range octets are rejected here, unlike the naive (\\d{1,3}\\.){3}\\d{1,3} pattern from m4_c17, which would incorrectly match this." },
        { "text": "256.1.1.1", "shouldMatch": false, "description": "256 exceeds the maximum valid octet value of 255." },
        { "text": "192.168.1", "shouldMatch": false, "description": "Missing the fourth octet." }

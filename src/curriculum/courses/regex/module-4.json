      "scaffold": "fading",
      "prompt": "Match an optional group containing 'v' followed by one or more digits strictly from start to end.",
      "ghostTemplate": "^(v\\d+)?$",
      "canonicalSolution": "^(v\\d+)?$",
      "testCases": [
        { "text": "v2", "shouldMatch": true },
        { "text": "v10", "shouldMatch": true },
        { "text": "", "shouldMatch": true },
        { "text": "version2", "shouldMatch": false },
        { "text": "v", "shouldMatch": false }
      ]
    },
    {
      "id": "m4_c7",
      "type": "compound",
      "scaffold": "fading",
      "prompt": "Match string starting with grouped HTTP methods 'GET' or 'POST'.",
      "ghostTemplate": "^(GET|POST)",
      "canonicalSolution": "^(GET|POST)",
      "testCases": [
        { "text": "GET /api/v1", "shouldMatch": true },
        { "text": "POST /submit", "shouldMatch": true },
        { "text": "PUT /api/v1", "shouldMatch": false },
        { "text": "DELETE /user", "shouldMatch": false },
        { "text": "TARGET /GET", "shouldMatch": false },
        { "text": "get /api/v1", "shouldMatch": false, "description": "Alternation inside the group is case-sensitive by default — lowercase 'get' does not match 'GET' without an i flag." },
        { "text": "post /submit", "shouldMatch": false, "description": "Same case-sensitivity contrast for the 'POST' alternative." }
      ]
    },

      "type": "atomic",
      "scaffold": "ghost",
      "prompt": "Group characters 'ab' into a single unit using ().",
      "ghostTemplate": "(ab)",
      "canonicalSolution": "(ab)",
      "testCases": [
        { "text": "ab", "shouldMatch": true },
        { "text": "a", "shouldMatch": false },
        { "text": "b", "shouldMatch": false }
      ]
    },
